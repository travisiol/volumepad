# Copy to .env.local for local runs. Never commit real keys.
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=
# $VOLUMEPAD mint: until set, the platform fee share is held (shown as held), not spent.
NEXT_PUBLIC_MINT=
# Launch wallet: creator of record of every coin, collects creator fees, pays prizes and withdrawals.
OPERATOR_SECRET_KEY=
LAUNCH_WEBHOOK=
LAUNCH_SECRET=
# TICK_SECRET = CRON_SECRET (Vercel cron sends Bearer CRON_SECRET)
TICK_SECRET=
CRON_SECRET=
SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3976
NEXT_PUBLIC_X_HANDLE=

# Fee split in whole percent (must add up to 100, else 60/30/10 is used)
LAUNCHER_SHARE=60
POT_SHARE=30
PLATFORM_SHARE=10
# The week and its anti-wash rules
WALLET_CAP_SOL=25
MIN_TRADERS=25
PRIZE_SPLIT=50,30,20
WEEK_HOURS=168
WEEK_ANCHOR=2026-01-05T00:00:00Z

JUPITER_API_URL=https://lite-api.jup.ag
VOLUMEPAD_DB_PATH=./data/volumepad.db

# Local rig only (scripts/play-ui.mjs): CLOCK_OFFSET_FILE, PUMP_API_URL, DEXSCREENER_API_URL
